---
import Icon from '../Icon.astro';
---
<div class="impact">
  <div class="impact-item reveal"><span class="ico"><Icon name="home" /></span><h3>Homes</h3><p>More than 100 homes built for indigent families in rural areas.</p></div>
  <div class="impact-item reveal"><span class="ico"><Icon name="church" /></span><h3>Churches</h3><p>Six churches built for communities.</p></div>
  <div class="impact-item reveal"><span class="ico"><Icon name="school" /></span><h3>Schools</h3><p>Three floors of primary and secondary school, and a new building for Isu Achara Primary School with an ICT centre, laboratory and multipurpose hall.</p></div>
  <div class="impact-item reveal"><span class="ico"><Icon name="book" /></span><h3>Scholarships and exam support</h3><p>Scholarships for more than 1,000 students at home and abroad, and 10,000 copies of WAEC past questions and answers donated to secondary schools in Ebonyi.</p></div>
  <div class="impact-item reveal"><span class="ico"><Icon name="medical" /></span><h3>Medical outreach</h3><p>Yearly medical screening and support, including free mobile medical testing and free prescribed drugs.</p></div>
  <div class="impact-item reveal"><span class="ico"><Icon name="gift" /></span><h3>Empowerment</h3><p>Annual empowerment programmes providing motorcycles, sewing machines, grinding machines, bags of rice and wrappers to families, with a focus on women.</p></div>
</div>
