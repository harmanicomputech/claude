---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import Record from '../components/sections/Record.astro';
import PillarGrid from '../components/sections/PillarGrid.astro';
import VideoFeature from '../components/sections/VideoFeature.astro';
import FoundationImpact from '../components/sections/FoundationImpact.astro';
import Gallery from '../components/sections/Gallery.astro';
import NewsList from '../components/sections/NewsList.astro';
import SectionHead from '../components/sections/SectionHead.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { companies } from '../data/content';
---
<Base preloadHero>
  <Hero />

  <!-- Intro -->
  <section class="section" aria-labelledby="intro-title">
    <div class="wrap intro">
      <div class="intro-photo reveal"><Pic name="portrait-hat" alt="Dr. Ifeanyi Chukwuma Odii in a black hat, smiling" sizes="(min-width: 900px) 420px, 100vw" /></div>
      <div class="intro-text reveal">
        <p class="eyebrow">Meet Dr. Odii</p>
        <h2 id="intro-title" class="title">Builder. Philanthropist. Son of Ebonyi.</h2>
        <p style="margin-top:22px">Dr. Ifeanyi Chukwuma Odii is a businessman and philanthropist with more than 20 years’ experience building and managing businesses across many sectors, from Nigeria into Sub-Saharan Africa. Through the Ebele and Anyichuks Foundation, he and his wife have built homes, churches and schools, and funded scholarships, medical outreach and empowerment programmes.</p>
        <p style="margin-top:26px;display:flex;flex-wrap:wrap;gap:12px">
          <a class="btn btn--primary" href="/about/">Read his story <Icon name="arrow" size={18} /></a>
          <a class="btn btn--outline" href="/leadership/">Business and leadership</a>
        </p>
      </div>
    </div>
  </section>

  <Record />

  <!-- Agenda -->
  <section class="section" aria-labelledby="agenda-title">
    <div class="wrap">
      <SectionHead eyebrow="Agenda for Ebonyi" title="Eight commitments. One plan, from day one." id="agenda-title"
        lede="A plan built on what Dr. Odii has already done through his businesses and his foundation, and on what he has promised the people of Ebonyi."
        href="/agenda/" linkText="The full agenda" />
      <PillarGrid link />
    </div>
  </section>

  <VideoFeature showQuotes={2}>
    <a class="more-link" href="/media/">Watch, read the transcript and see the gallery <Icon name="arrow" size={18} /></a>
  </VideoFeature>

  <!-- Foundation -->
  <section class="section section--sand" aria-labelledby="foundation-title">
    <div class="wrap">
      <SectionHead eyebrow="Philanthropy" title="The Ebele and Anyichuks Foundation" id="foundation-title"
        lede="For more than ten years, Dr. Odii and his wife have supported and empowered people through their foundation, with a focus on young people, education and caring for the less privileged."
        href="/foundation/" linkText="The foundation’s work" />
      <FoundationImpact />
    </div>
  </section>

  <!-- Leadership teaser -->
  <section class="section" aria-labelledby="lead-title">
    <div class="wrap">
      <SectionHead eyebrow="Business and leadership" title="He has built. He will build Ebonyi." id="lead-title"
        lede="Two groups spanning seven sectors, grown from Nigeria across Sub-Saharan Africa." href="/leadership/" linkText="Business and leadership" />
      <div class="companies">
        {companies.map((c) => (
          <div class="company reveal">
            <h3>{c.group}</h3>
            <p class="role">{c.role}</p>
            <ul>{c.subsidiaries.map((s) => <li>{s}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery teaser -->
  <section class="section section--sand" aria-labelledby="gallery-title">
    <div class="wrap">
      <SectionHead eyebrow="Gallery" title="Moments." id="gallery-title" href="/media/#gallery" linkText="Full gallery" />
      <Gallery limit={8} />
    </div>
  </section>

  <!-- News -->
  <section class="section" aria-labelledby="news-title">
    <div class="wrap">
      <SectionHead eyebrow="News and events" title="On the road to 6 February." id="news-title" href="/news/" linkText="All news" />
      <NewsList limit={3} />
    </div>
  </section>

  <CtaBand />
</Base>
