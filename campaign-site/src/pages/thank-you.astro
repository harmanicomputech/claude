---
// Shown after the volunteer form is submitted without JavaScript.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
const shareText = encodeURIComponent(`${site.name} for Governor, Ebonyi State 2027. ${site.slogan}! Join the movement: ${site.url} ${site.hashtags.join(' ')}`);
---
<Base title="Thank you" path="/thank-you/" noindex>
  <section class="section">
    <div class="wrap prose">
      <p class="eyebrow">Get involved</p>
      <h1>Thank you. You’re in.</h1>
      <p class="lede" style="color:var(--muted)">The campaign team in your LGA will contact you soon. In the meantime, bring one more person along.</p>
      <p style="margin-top:28px;display:flex;flex-wrap:wrap;gap:12px">
        <a class="btn btn--primary" href={`https://wa.me/?text=${shareText}`} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} /> Share on WhatsApp</a>
        <a class="btn btn--outline" href="/">Back to the home page</a>
      </p>
    </div>
  </section>
</Base>
