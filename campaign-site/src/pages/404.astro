---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" path="/404.html" noindex>
  <section class="section">
    <div class="wrap prose">
      <p class="eyebrow">404</p>
      <h1>This page could not be found.</h1>
      <p class="lede" style="color:var(--muted)">It may have moved. Everything about the campaign is on the home page.</p>
      <p style="margin-top:28px"><a class="btn btn--primary" href="/">Go to the home page</a></p>
    </div>
  </section>
</Base>
