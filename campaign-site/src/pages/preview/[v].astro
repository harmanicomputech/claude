---
// Temporary: hero design options for review. Delete this folder once a design is chosen.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
export function getStaticPaths() {
  return ['a', 'b', 'c'].map((v) => ({ params: { v: `hero-${v}` }, props: { variant: v } }));
}
const { variant } = Astro.props;
---
<Base title={`Hero option ${variant.toUpperCase()}`} path={`/preview/hero-${variant}/`} noindex>
  <Hero variant={variant} />
  <section class="section"><div class="wrap"><p class="eyebrow">About</p><h2 class="title">Builder. Philanthropist. Son of Ebonyi.</h2></div></section>
</Base>
<script>
  import { initCountdown } from '../../scripts/home';
  initCountdown();
</script>
