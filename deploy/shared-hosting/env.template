# Election Shield: production settings for cPanel / DirectAdmin hosting.
# Fill in every value marked CHANGE-ME, then save this file as ".env".

APP_NAME="Election Shield"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=https://CHANGE-ME.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL database created in the hosting control panel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

# Shared hosting: files for sessions/cache, database queue worked by the cron.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database
SCHEDULER_RUNS_QUEUE=true
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Admin console at https://your-domain/admin
ADMIN_PASSWORD={{ADMIN_PASSWORD}}

MAIL_MAILER=smtp
MAIL_SCHEME={{MAIL_SCHEME}}
MAIL_HOST={{MAIL_HOST}}
MAIL_PORT={{MAIL_PORT}}
MAIL_USERNAME={{MAIL_USERNAME}}
MAIL_PASSWORD={{MAIL_PASSWORD}}
MAIL_FROM_ADDRESS="{{MAIL_FROM_ADDRESS}}"
MAIL_FROM_NAME="Election Shield"

# Emails for results, incidents, corrections and the hourly summary.
NOTIFY_EMAILS={{NOTIFY_EMAILS}}
NOTIFY_EMAIL_EACH_RESULT=true
NOTIFY_HOURLY_SUMMARY=true

# Africa's Talking: "sandbox" + sandbox API key for testing; your app
# username + live key for election day.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=CHANGE-ME
AFRICASTALKING_SENDER_ID=

# USSD. Register https://your-domain/api/ussd/{USSD_CALLBACK_SECRET} as the
# callback URL (the admin console shows the exact URL).
USSD_SERVICE_CODE="*384*CHANGE-ME#"
USSD_CALLBACK_SECRET={{USSD_CALLBACK_SECRET}}
USSD_ALLOWED_IPS=
USSD_COUNTRY_CODE=234
USSD_REFERENCE_DIGITS=6
USSD_SMS_CONFIRMATION=true

# Election. Keep windows off while testing; set true before election day.
ELECTION_NAME="Ebonyi State Governorship Election"
ELECTION_DATE=2027-02-06
ELECTION_TIMEZONE=Africa/Lagos
ELECTION_ENFORCE_WINDOWS=false
ELECTION_PRESENCE_OPENS_AT=07:00
ELECTION_RESULTS_OPEN_AT=14:30
ELECTION_RESULTS_CLOSE_AT="2027-02-08 23:59"
ELECTION_PARTIES=APC,PDP,LP,OTHERS
ELECTION_REQUIRE_KNOWN_PU=true
ELECTION_PIN_MAX_ATTEMPTS=3
ELECTION_PIN_LOCK_MINUTES=30
ELECTION_URGENT_INCIDENT_TYPES=violence
ELECTION_PRESENCE_REMINDER_AT=08:00
ELECTION_RESULTS_REMINDER_AT=17:00
ELECTION_API_TOKEN={{ELECTION_API_TOKEN}}

# Results dashboard (not built yet).
DASHBOARD_WEBHOOK_URL=
DASHBOARD_API_TOKEN=
DASHBOARD_WEBHOOK_SECRET=
DASHBOARD_TIMEOUT=10
