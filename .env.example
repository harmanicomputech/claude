APP_NAME="Election Shield"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=election_shield
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Africa's Talking (use username "sandbox" with your sandbox API key for testing)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# USSD
USSD_SERVICE_CODE="*384*123#"
USSD_COUNTRY_CODE=234
USSD_REFERENCE_DIGITS=6
USSD_SMS_CONFIRMATION=true
# Callback protection: set a long random secret and register
# https://your-domain/api/ussd/{secret} as the callback URL in Africa's Talking.
USSD_CALLBACK_SECRET=
# Optional comma-separated IPs / CIDR ranges allowed to call the callback.
USSD_ALLOWED_IPS=

# Election
ELECTION_NAME="Ebonyi State Election"
ELECTION_DATE=2027-02-06
ELECTION_TIMEZONE=Africa/Lagos
ELECTION_ENFORCE_WINDOWS=true
ELECTION_PRESENCE_OPENS_AT=07:00
ELECTION_RESULTS_OPEN_AT=14:30
ELECTION_RESULTS_CLOSE_AT="2027-02-08 23:59"
ELECTION_PARTIES=APC,PDP,LP,APGA,OTHERS
ELECTION_REQUIRE_KNOWN_PU=true
ELECTION_PIN_MAX_ATTEMPTS=3
ELECTION_PIN_LOCK_MINUTES=30
ELECTION_URGENT_INCIDENT_TYPES=violence
ELECTION_PRESENCE_REMINDER_AT=08:00
ELECTION_RESULTS_REMINDER_AT=17:00
# Bearer token for /api/corrections and /api/reports (empty disables them).
ELECTION_API_TOKEN=

# Email for results, incidents, correction requests and the hourly summary
# (comma-separated). Needs a real MAIL_MAILER above.
NOTIFY_EMAILS=
NOTIFY_EMAIL_EACH_RESULT=true
NOTIFY_HOURLY_SUMMARY=true

# External results dashboard (leave URL empty to disable)
DASHBOARD_WEBHOOK_URL=
DASHBOARD_API_TOKEN=
DASHBOARD_WEBHOOK_SECRET=
DASHBOARD_TIMEOUT=10
